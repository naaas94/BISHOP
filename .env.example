# Host root for persistent Bishop data (spec §8.5).
# Linux/macOS: ~/bishop_data expands in the shell; Docker Compose reads this value as-is.
# Windows: use an explicit path (Docker Desktop does not expand ~). Example:
#   BISHOP_DATA_ROOT=C:/Users/you/bishop_data
BISHOP_DATA_ROOT=~/bishop_data

# Anthropic API key for pre-filter-worker, enrichment-batcher, and batch-poller.
# Compose interpolates ${ANTHROPIC_API_KEY} from this file or your shell/user env.
# ANTHROPIC_API_KEY=sk-ant-...

# Global scraper wake interval (seconds). Every adapter in ADAPTER_REGISTRY runs
# on this single tick regardless of the (currently unwired) per-source Appendix B
# cadence in bishop_shared/scraper_config.py::SOURCE_SCHEDULE_INTERVAL_SEC. Default
# 21600 (6h) produced discovery waves ~5.5-6h apart — longer than the prompt cache's
# 1h TTL (bishop_shared/prompt_cache.py::CACHE_TTL), so every wave cold-starts cache
# keys A/B/C. 2700 (45min) keeps waves inside one TTL window at the cost of ~7-8x
# more incremental (mostly-empty) fetches per source per day. Revisit after the
# warmup ping (FU-CACHE-WARMUP-01) and this interval have both run live for a few
# days — see .dev/plans/prompt-caching/artifacts/llm-models-and-cache.md.
BISHOP_SCRAPER_SCHEDULE_INTERVAL_SEC=2700

# Soft-launch overlay lookback (days). Caps cold-start fetch for every registered
# source without rewriting BACKFILL_CONFIG (arxiv 60 / github 30 / …). Compose
# default was 1, then 7; 60 is the post-option-1 faucet (2 months). Unset +
# BISHOP_BACKFILL_ENABLED=1 restores intended §18 windows. Only applies on cold
# start (scraper_state.last_successful_run_at is NULL). Warm sources need a
# scraper_state rewind to now-60d. Do not rewind Hugging Face.
BISHOP_BACKFILL_WINDOW_OVERRIDE_DAYS=60

# Harvest GitHub tap daily budget (USD). 0 kills the GitHub tap.
# Scraper and query-api both read this (dashboard N_cap follows the kill).
BISHOP_HARVEST_DAILY_BUDGET_USD=2
BISHOP_HARVEST_ENABLED=1
